# ===========================================
# VIBEMOTION ENVIRONMENT VARIABLES
# Copy this to .env.local and fill in values
# ===========================================

# -------- AI APIs (required) --------

# Google Gemini — for frame analysis + storyboard generation
# Get at: https://console.cloud.google.com/apis/credentials
GOOGLE_API_KEY=your-google-api-key-here

# OpenAI Whisper — for audio transcription
# Get at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# Note: a NEXT_PUBLIC_OPENAI_API_KEY is referenced in UploadPanel.tsx, but only
# as a client-side heuristic to warn when no key looks configured. It is NOT used
# to make browser-side OpenAI calls, so do not set it here — that would expose a
# secret to the client. Transcription runs server-side using OPENAI_API_KEY above.

# -------- Supabase (required for auth + protected dashboard) --------

# Get at: https://supabase.com/dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# -------- Stripe (optional — checkout falls back to a mock if unset) --------

# Get at: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_PRO_PRICE_ID=price_placeholder

# -------- App Config --------

# Your deployment URL (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -------- Optional: Extra AI features --------

# ElevenLabs — for voiceover generation (optional)
ELEVENLABS_API_KEY=your-elevenlabs-key-here

# Replicate — for AI image/video generation (optional)
REPLICATE_API_TOKEN=your-replicate-token-here
