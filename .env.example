# ===========================================
# REQUIRED API KEYS
# ===========================================

# Google API Key for Gemini (storyboard + code generation)
# Get your API key from: https://console.cloud.google.com/apis/credentials
# Enable the "Generative Language API" in your GCP project
GOOGLE_API_KEY=your-google-api-key-here

# ===========================================
# OPTIONAL API KEYS (for additional features)
# ===========================================

# OpenAI API Key for Whisper transcription
# Get your API key from: https://platform.openai.com/api-keys
# Cost: ~$0.006 per minute of audio (~$0.36 per hour)
OPENAI_API_KEY=sk-your-openai-key-here

# ElevenLabs API Key for voice generation
# Get your API key from: https://elevenlabs.io/
# Cost: ~$0.30 per 1000 characters
ELEVENLABS_API_KEY=your-elevenlabs-key-here

# Replicate API Token for image generation (Nano Banana Pro)
# Get your token from: https://replicate.com/account/api-tokens
# Cost: ~$0.004 per image
REPLICATE_API_TOKEN=your-replicate-token-here

# Deepgram API Key for transcription (alternative to OpenAI)
# Get your API key from: https://console.deepgram.com/
# DEEPGRAM_API_KEY=your-deepgram-key-here
